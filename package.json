{
  "name": "orionmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "npm run build:server && npm run build:ui",
    "start": "node dist/server/http.js",
    "local": "node dist/server/local.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "jose": "6.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
