# Railway injects PORT. Never commit real tokens or secrets.
PORT=8080
# Set after Railway generates the HTTPS public domain. No trailing /mcp here.
ORIONMCP_PUBLIC_URL=
# Generate 32 random bytes as lowercase hex. Keep this key across deployments.
ORIONMCP_STORAGE_KEY=
# Railway persistent volume path. Use a writable local path for self-hosting.
ORIONMCP_DB_PATH=/data/auth.sqlite
